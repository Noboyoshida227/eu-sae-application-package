# ============================================================
# .gitignore for eu-sae-dashboard
# ============================================================

# ---- Portable R library (recreated by install_packages.R on first run) ----
r_local_library/

# ---- Generated outputs (regenerated each time the pipeline runs) ----
outputs/*
!outputs/.gitkeep
!outputs/data/
outputs/data/*
!outputs/data/.gitkeep
!outputs/tables/
outputs/tables/*
!outputs/tables/.gitkeep
!outputs/figures/
outputs/figures/*
!outputs/figures/.gitkeep
final_report.html
Rplots.pdf

# ---- Run logs ----
app_runs/

# ---- R environment / session ----
.Rhistory
.RData
.Rproj.user/
.Renviron
renv/library/
renv/staging/
renv/local/
renv/python/

# ---- Local package version report ----
package_versions.local.csv
package_versions.lock.csv

# ---- Temporary knitr figure caches ----
.knitr_figs_*/

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
.claude/
*.swp
*~

# ---- Logs and tmp ----
*.log
tmp/
temp/
dist/
dependency_lock_check.csv
release_manifest.csv

# ---- Local config that should not be shared ----
.env
.env.local
api_keys.yml
secrets.yml

# ---- Never commit: GPL-2 example data (shipped with the release archive) ----
# Derived from the CRAN `sae` package (GPL-2). Kept out of this MIT-licensed
# repository deliberately; see Data/Spain/README.md and THIRD_PARTY_NOTICES.md.
Data/Spain/survey.rds
Data/Spain/auxiliary.rds

# ---- Build artifacts and working folders ----
node_modules/
*.zip
_previous_release_*/
_to_delete/
release_candidate_*/

# ---- Generated outputs at any depth (not only the repository root) ----
**/outputs/data/*
**/outputs/tables/*
**/outputs/figures/*
!**/outputs/**/.gitkeep
**/app_runs/
